{
  "name": "notification-pi-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Optional, exclusively owned App Pi session in the event-service process",
  "engines": { "node": ">=22.19.0", "npm": ">=10" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
