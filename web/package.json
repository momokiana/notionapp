{
  "name": "notifier-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.2" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test test/*.test.ts",
    "test:browser": "node --import tsx --test test/browser.ts",
    "test:production": "node test/production-smoke.mjs",
    "test:drafts-browser": "node --import tsx --test test/drafts-browser.ts",
    "test:drafts-production": "WEB_TEST_PRODUCTION=1 node --import tsx --test test/drafts-browser.ts",
    "check": "npm test && npm run build",
    "fixture": "node test/fixture-cli.mjs"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  }
}
