<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- cp to ~/Library/LaunchAgents/ , fix the two paths, then: launchctl load -w ~/Library/LaunchAgents/com.xiaoaixiaoai.hostd.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.xiaoaixiaoai.hostd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABS/PATH/TO/xiaoaixiaoai/apps/hostd/bin/xiaoaixiaoai</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/ABS/HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/xiaoaixiaoai-hostd.log</string>
  <key>StandardErrorPath</key><string>/tmp/xiaoaixiaoai-hostd.log</string>
</dict>
</plist>
